{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-skin-routine",
  // The reminder server. Everything outside /api/ is served straight from ./dist.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "REMINDERS", "class_name": "Reminders" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Reminders"] }],
  "vars": {
    // Push services ask who sends the reminders. This is the app's own address.
    "PUSH_CONTACT": "https://my-skin-routine.pages.dev"
  },
  "observability": { "enabled": true }
}
