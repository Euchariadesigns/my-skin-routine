{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-skin-routine",
  // The reminder server. The app itself is served by Cloudflare Pages at my-skin-routine.pages.dev,
  // which passes /api/* calls here through a service binding (see functions/api/[[path]].ts).
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // No public workers.dev address: only the Pages app can reach this Worker.
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "REMINDERS", "class_name": "Reminders" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Reminders"] }],
  "vars": {
    // Push services ask who sends the reminders. This is the app's own address.
    "PUSH_CONTACT": "https://my-skin-routine.pages.dev"
  },
  "observability": { "enabled": true }
}
